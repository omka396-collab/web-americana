---
import { siteConfig } from '../data/siteData';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="#inicio" class="flex items-center gap-3 group" aria-label="Ir al inicio de Americana del Plástico">
        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-emerald-600 shadow-md transition-transform duration-300 group-hover:scale-105 bg-white">
          <img 
            src={siteConfig.logo} 
            alt="Logo Americana del Plástico" 
            class="w-full h-full object-cover"
            width="48"
            height="48"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-lg md:text-xl font-extrabold text-slate-800 tracking-tight leading-tight group-hover:text-emerald-700 transition-colors">
            Americana del Plástico
          </span>
          <span class="text-xs font-semibold text-emerald-600 tracking-wider uppercase">
            C.A. • Fábrica de Bolsas
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        <ul class="flex items-center gap-7 text-sm font-medium text-slate-600">
          <li>
            <a href="#inicio" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Inicio
            </a>
          </li>
          <li>
            <a href="#nosotros" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              ¿Quiénes somos?
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Productos
            </a>
          </li>
          <li>
            <a href="#maquinaria" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Maquinaria y Planta
            </a>
          </li>
          <li>
            <a href="#trayectoria" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Trayectoria
            </a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Contacto
            </a>
          </li>
        </ul>

        <!-- Action CTA -->
        <a 
          href="#contacto" 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-emerald-700 via-emerald-600 to-emerald-500 hover:from-emerald-800 hover:to-emerald-600 shadow-md shadow-emerald-700/20 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
        >
          Solicitar Cotización
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        class="lg:hidden p-2 rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
        aria-label="Abrir menú principal"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu" 
    class="lg:hidden hidden border-t border-gray-100 bg-white/98 backdrop-blur-xl transition-all duration-300 shadow-xl"
    aria-hidden="true"
  >
    <div class="px-4 pt-3 pb-6 space-y-2">
      <a href="#inicio" class="mobile-link block px-4 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        Inicio
      </a>
      <a href="#nosotros" class="mobile-link block px-4 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        ¿Quiénes somos?
      </a>
      <a href="#productos" class="mobile-link block px-4 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        Productos
      </a>
      <a href="#maquinaria" class="mobile-link block px-4 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        Maquinaria y Planta
      </a>
      <a href="#trayectoria" class="mobile-link block px-4 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        Trayectoria
      </a>
      <a href="#contacto" class="mobile-link block px-4 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
        Contacto
      </a>
      <div class="pt-4">
        <a 
          href="#contacto" 
          class="mobile-link flex items-center justify-center w-full px-5 py-3 rounded-lg text-base font-semibold text-white bg-gradient-to-r from-emerald-700 via-emerald-600 to-emerald-500 shadow-md text-center"
        >
          Solicitar Cotización
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-link');

  if (btn && menu && hamburgerIcon && closeIcon) {
    const toggleMenu = () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.setAttribute('aria-hidden', String(isExpanded));
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };

    btn.addEventListener('click', toggleMenu);

    links.forEach(link => {
      link.addEventListener('click', () => {
        if (!menu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }
</script>
