---
import { siteConfig } from '../data/siteData';
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="#inicio" class="flex items-center gap-3 group" aria-label="Ir al inicio de Americana del Plástico">
        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-emerald-600 shadow-md transition-transform duration-300 group-hover:scale-105 bg-white">
          <img 
            src={siteConfig.logo} 
            alt="Logo Americana del Plástico" 
            class="w-full h-full object-cover"
            width="48"
            height="48"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-lg md:text-xl font-extrabold text-slate-800 tracking-tight leading-tight group-hover:text-emerald-700 transition-colors">
            Americana del Plástico
          </span>
          <span class="text-xs font-semibold text-emerald-600 tracking-wider uppercase">
            C.A. • Fábrica de Bolsas
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        <ul class="flex items-center gap-7 text-sm font-medium text-slate-600">
          <li>
            <a href="#inicio" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Inicio
            </a>
          </li>
          <li>
            <a href="#nosotros" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              ¿Quiénes somos?
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-emerald-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-emerald-500 after:transition-all">
              Productos
            </a>
          </li>

        </ul>

        <!-- Action CTA -->
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-emerald-700 via-emerald-600 to-emerald-500 hover:from-emerald-800 hover:to-emerald-600 shadow-md shadow-emerald-700/20 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
        >
          Solicitar Cotización
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        class="lg:hidden p-2 rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
        aria-label="Abrir menú principal"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

    </div>
  </div>
</header>

<!-- Overlay backdrop -->
<div
  id="drawer-overlay"
  class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
></div>

<!-- Mobile Drawer (slide from right) -->
<nav
  id="mobile-drawer"
  class="fixed top-0 right-0 z-50 h-full w-72 bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
  aria-label="Menú móvil"
  aria-hidden="true"
>
  <!-- Drawer header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
    <div class="flex items-center gap-2">
      <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-emerald-600 bg-white">
        <img src={siteConfig.logo} alt="Logo" class="w-full h-full object-cover" width="36" height="36" />
      </div>
      <span class="text-sm font-extrabold text-slate-800 tracking-tight">Americana del Plástico</span>
    </div>
    <button
      id="close-drawer-btn"
      class="p-1.5 rounded-lg text-slate-500 hover:text-emerald-700 hover:bg-emerald-50 transition-colors"
      aria-label="Cerrar menú"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Drawer links -->
  <div class="flex-1 overflow-y-auto px-4 py-6 space-y-1">
    <a href="#inicio" class="drawer-link flex items-center gap-3 px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      Inicio
    </a>
    <a href="#nosotros" class="drawer-link flex items-center gap-3 px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      ¿Quiénes somos?
    </a>
    <a href="#productos" class="drawer-link flex items-center gap-3 px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
      </svg>
      Productos
    </a>

  </div>

  <!-- CTA bottom -->
  <div class="px-4 pb-8 pt-4 border-t border-slate-100">
    <a 
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="drawer-link flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-xl text-base font-bold text-white bg-gradient-to-r from-emerald-700 via-emerald-600 to-emerald-500 shadow-md"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.86L0 24l6.291-1.507A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.001-1.368l-.36-.214-3.733.894.939-3.629-.235-.374A9.818 9.818 0 1112 21.818z"/>
      </svg>
      Solicitar Cotización
    </a>
  </div>
</nav>

<script>
  const btn        = document.getElementById('mobile-menu-btn');
  const closeBtn   = document.getElementById('close-drawer-btn');
  const drawer     = document.getElementById('mobile-drawer');
  const overlay    = document.getElementById('drawer-overlay');
  const hamIcon    = document.getElementById('hamburger-icon');
  const closeIcon  = document.getElementById('close-icon');
  const links      = document.querySelectorAll('.drawer-link');

  const openDrawer = () => {
    drawer?.classList.remove('translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    btn?.setAttribute('aria-expanded', 'true');
    drawer?.setAttribute('aria-hidden', 'false');
    hamIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    drawer?.classList.add('translate-x-full');
    overlay?.classList.remove('opacity-100');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    btn?.setAttribute('aria-expanded', 'false');
    drawer?.setAttribute('aria-hidden', 'true');
    hamIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  };

  btn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  links.forEach(link => link.addEventListener('click', closeDrawer));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
</script>
