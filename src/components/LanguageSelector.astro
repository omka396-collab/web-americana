---
import type { Locale } from '../data/translations';

interface Props {
  currentLocale?: string;
  isMobile?: boolean;
}

const { currentLocale = 'es', isMobile = false } = Astro.props;

const current: Locale = currentLocale?.startsWith('zh') ? 'zh' : currentLocale?.startsWith('en') ? 'en' : 'es';

const options: { code: Locale; label: string; flag: string; path: string }[] = [
  { code: 'es', label: 'Español', flag: '🇪🇸', path: '/' },
  { code: 'en', label: 'English', flag: '🇺🇸', path: '/en' },
  { code: 'zh', label: '中文', flag: '🇨🇳', path: '/zh' },
];
---

{isMobile ? (
  <div class="px-4 py-3 bg-slate-50 rounded-xl border border-slate-200/80">
    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 flex items-center justify-between">
      <span>Idioma / Language</span>
      <span class="text-xs font-semibold text-emerald-600 uppercase">
        {options.find(o => o.code === current)?.label}
      </span>
    </div>
    <div class="grid grid-cols-3 gap-1.5">
      {options.map((opt) => {
        const isActive = opt.code === current;
        return (
          <a
            href={opt.path}
            class={`flex items-center justify-center gap-1.5 py-2 px-2 rounded-lg text-xs font-bold transition-all text-center ${
              isActive
                ? 'bg-emerald-600 text-white shadow-sm'
                : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'
            }`}
          >
            <span>{opt.flag}</span>
            <span>{opt.code.toUpperCase()}</span>
          </a>
        );
      })}
    </div>
  </div>
) : (
  <div class="relative inline-block text-left lang-menu-container">
    <button
      type="button"
      class="lang-menu-btn inline-flex items-center gap-1 sm:gap-1.5 px-2 py-1.5 sm:px-3 rounded-lg text-xs font-bold text-slate-700 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 border border-slate-200 transition-colors cursor-pointer"
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Cambiar idioma"
    >
      <span class="text-sm leading-none">{options.find(o => o.code === current)?.flag}</span>
      <span class="uppercase tracking-wider">{current}</span>
      <svg class="lang-arrow w-3 h-3 sm:w-3.5 sm:h-3.5 text-slate-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <div
      class="lang-dropdown absolute right-0 mt-1.5 w-36 rounded-xl bg-white shadow-xl border border-slate-100 py-1.5 hidden z-50 backdrop-blur-md"
      role="menu"
      aria-orientation="vertical"
    >
      {options.map((opt) => {
        const isActive = opt.code === current;
        return (
          <a
            href={opt.path}
            class={`flex items-center justify-between px-3.5 py-2 text-xs font-semibold transition-colors ${
              isActive
                ? 'bg-emerald-50 text-emerald-700 font-bold'
                : 'text-slate-700 hover:bg-slate-50 hover:text-emerald-600'
            }`}
            role="menuitem"
          >
            <div class="flex items-center gap-2">
              <span>{opt.flag}</span>
              <span>{opt.label}</span>
            </div>
            {isActive && (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            )}
          </a>
        );
      })}
    </div>
  </div>
)}

<script>
  const containers = document.querySelectorAll('.lang-menu-container');

  containers.forEach((container) => {
    const btn = container.querySelector('.lang-menu-btn');
    const dropdown = container.querySelector('.lang-dropdown');
    const arrow = container.querySelector('.lang-arrow');

    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();

        // Close any other open dropdowns
        document.querySelectorAll('.lang-dropdown').forEach((d) => {
          if (d !== dropdown) {
            d.classList.add('hidden');
            d.closest('.lang-menu-container')?.querySelector('.lang-arrow')?.classList.remove('rotate-180');
            d.closest('.lang-menu-container')?.querySelector('.lang-menu-btn')?.setAttribute('aria-expanded', 'false');
          }
        });

        const isHidden = dropdown.classList.contains('hidden');
        if (isHidden) {
          dropdown.classList.remove('hidden');
          arrow?.classList.add('rotate-180');
          btn.setAttribute('aria-expanded', 'true');
        } else {
          dropdown.classList.add('hidden');
          arrow?.classList.remove('rotate-180');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('.lang-dropdown').forEach((dropdown) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
        dropdown.closest('.lang-menu-container')?.querySelector('.lang-arrow')?.classList.remove('rotate-180');
        dropdown.closest('.lang-menu-container')?.querySelector('.lang-menu-btn')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
