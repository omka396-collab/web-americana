---
import { productsData } from '../data/siteData';
---

<section id="productos" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title & Intro -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
        Catálogo Especializado
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Nuestros Productos
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Soluciones en polietileno de alta y baja densidad adaptadas a cada sector: alimentos, panadería, aseo, comercio y refrigeración industrial.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {productsData.map((product) => (
        <article class="group flex flex-col bg-slate-50 border border-slate-200/90 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
          
          <!-- Image Container with Zoom Action -->
          <div class="relative h-64 overflow-hidden bg-slate-200 cursor-pointer product-image-wrapper" data-src={product.image} data-title={product.name} data-desc={product.description}>
            <img 
              src={product.image} 
              alt={product.name} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-slate-900/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/90 text-slate-900 text-xs font-bold shadow-md">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                </svg>
                Ver Imagen
              </span>
            </div>
            
            <!-- Density Badge -->
            <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-white/95 text-emerald-800 text-xs font-bold shadow-sm backdrop-blur-sm">
              {product.density}
            </span>
          </div>

          <!-- Card Content -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">
                {product.category}
              </div>
              <h3 class="text-xl font-extrabold text-slate-900 mb-2 group-hover:text-emerald-700 transition-colors">
                {product.name}
              </h3>
              <p class="text-xs font-semibold text-slate-500 mb-3 italic">
                {product.tagline}
              </p>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                {product.description}
              </p>

              <!-- Technical Features List -->
              <ul class="space-y-1.5 mb-6 text-xs text-slate-700">
                {product.features.map((feature) => (
                  <li class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- CTA per product -->
            <a 
              href={`#contacto?producto=${encodeURIComponent(product.name)}`}
              class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg text-xs font-bold text-slate-800 bg-white border border-slate-300 hover:bg-emerald-600 hover:text-white hover:border-emerald-600 shadow-sm transition-all duration-200 mt-auto"
            >
              Consultar por {product.name}
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- Custom Manufacturing Banner -->
    <div class="mt-16 p-8 rounded-3xl bg-gradient-to-r from-emerald-900 via-slate-900 to-slate-950 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="max-w-2xl">
        <span class="inline-block px-3 py-1 rounded bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-2">
          Fabricación a la Medida
        </span>
        <h3 class="text-2xl md:text-3xl font-black text-white">
          ¿Buscás calibres, medidas o colores personalizados?
        </h3>
        <p class="mt-2 text-sm md:text-base text-slate-300 leading-relaxed">
          En Americana del Plástico fabricamos sobre especificación para distribuidoras, franquicias y comercios en todo el país.
        </p>
      </div>
      <a 
        href="#contacto" 
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-bold text-sm text-slate-950 bg-emerald-400 hover:bg-emerald-300 shadow-lg shadow-emerald-500/25 transition-all duration-300 flex-shrink-0 cursor-pointer"
      >
        Hablar con un Asesor Técnico
      </a>
    </div>

  </div>

  <!-- Accessible Modal Lightbox for Image Zoom -->
  <div 
    id="image-lightbox-modal" 
    class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Vista detallada de producto"
  >
    <div class="relative max-w-4xl w-full bg-slate-900 rounded-2xl overflow-hidden shadow-2xl border border-white/10">
      <button 
        id="close-lightbox-btn" 
        class="absolute top-4 right-4 z-10 p-2 rounded-full bg-black/50 text-white hover:bg-emerald-600 transition-colors cursor-pointer"
        aria-label="Cerrar vista detallada"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <div class="flex flex-col md:flex-row max-h-[85vh]">
        <div class="md:w-3/5 bg-black flex items-center justify-center p-4">
          <img id="lightbox-img" src="" alt="" class="max-h-[60vh] md:max-h-[75vh] w-auto object-contain rounded" />
        </div>
        <div class="md:w-2/5 p-6 flex flex-col justify-between bg-slate-900 text-white">
          <div>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Detalle del Producto</span>
            <h4 id="lightbox-title" class="text-2xl font-black mt-1 mb-3 text-white"></h4>
            <p id="lightbox-desc" class="text-sm text-slate-300 leading-relaxed"></p>
          </div>
          <div class="pt-6">
            <a 
              href="#contacto" 
              id="lightbox-quote-btn"
              class="w-full inline-flex items-center justify-center px-5 py-3 rounded-xl font-bold text-sm text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition-colors"
            >
              Cotizar este producto
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const wrappers = document.querySelectorAll('.product-image-wrapper');
  const modal = document.getElementById('image-lightbox-modal');
  const closeBtn = document.getElementById('close-lightbox-btn');
  const lightImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightTitle = document.getElementById('lightbox-title');
  const lightDesc = document.getElementById('lightbox-desc');
  const quoteBtn = document.getElementById('lightbox-quote-btn');

  const openModal = (src: string, title: string, desc: string) => {
    if (!modal || !lightImg || !lightTitle || !lightDesc) return;
    lightImg.src = src;
    lightImg.alt = title;
    lightTitle.textContent = title;
    lightDesc.textContent = desc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  wrappers.forEach((el) => {
    el.addEventListener('click', () => {
      const src = el.getAttribute('data-src') || '';
      const title = el.getAttribute('data-title') || '';
      const desc = el.getAttribute('data-desc') || '';
      openModal(src, title, desc);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  quoteBtn?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
