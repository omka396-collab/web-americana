---
import { productsData } from '../data/siteData';
---

<section id="productos" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title & Intro -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
        Catálogo Especializado
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Nuestros Productos
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Soluciones en polietileno de alta y baja densidad adaptadas a cada sector: alimentos, panadería, aseo, comercio y refrigeración industrial.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
      {productsData.map((product) => (
        <article
          class="group flex flex-col bg-slate-50 border border-slate-200/90 rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300 cursor-pointer product-card"
          data-src={product.image}
          data-title={product.name}
          data-desc={product.description}
          data-density={product.density}
          data-features={JSON.stringify(product.features)}
          data-category={product.category}
        >
          <!-- Image — aspect ratio vertical 3:4 -->
          <div class="relative aspect-[3/4] overflow-hidden bg-slate-200">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="300"
              height="400"
            />
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/90 text-slate-900 text-xs font-bold shadow-md">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                Ver detalle
              </span>
            </div>
            <!-- Density Badge -->
            <span class="absolute top-2 right-2 px-2 py-0.5 rounded bg-white/90 text-emerald-800 text-[10px] font-bold shadow-sm backdrop-blur-sm">
              {product.density}
            </span>
          </div>

          <!-- Compact Card Content -->
          <div class="p-4 flex flex-col gap-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">
              {product.category}
            </span>
            <h3 class="text-sm font-extrabold text-slate-900 leading-tight group-hover:text-emerald-700 transition-colors">
              {product.name}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">
              {product.tagline}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Custom Manufacturing Banner -->
    <div class="mt-16 p-8 rounded-3xl bg-gradient-to-r from-emerald-900 via-slate-900 to-slate-950 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="max-w-2xl">
        <span class="inline-block px-3 py-1 rounded bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-2">
          Fabricación a la Medida
        </span>
        <h3 class="text-2xl md:text-3xl font-black text-white">
          ¿Buscás calibres, medidas o colores personalizados?
        </h3>
        <p class="mt-2 text-sm md:text-base text-slate-300 leading-relaxed">
          En Americana del Plástico fabricamos sobre especificación para distribuidoras, franquicias y comercios en todo el país.
        </p>
      </div>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-bold text-sm text-slate-950 bg-emerald-400 hover:bg-emerald-300 shadow-lg shadow-emerald-500/25 transition-all duration-300 flex-shrink-0 cursor-pointer"
      >
        Hablar con un Asesor Técnico
      </a>
    </div>

  </div>

  <!-- Modal Lightbox -->
  <div
    id="product-modal"
    class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Detalle del producto"
  >
    <div class="relative max-w-3xl w-full bg-white rounded-2xl overflow-hidden shadow-2xl">
      
      <!-- Close button -->
      <button
        id="close-modal-btn"
        class="absolute top-4 right-4 z-10 p-2 rounded-full bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 transition-colors cursor-pointer"
        aria-label="Cerrar detalle"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <div class="flex flex-col md:flex-row max-h-[88vh] overflow-y-auto">
        
        <!-- Image -->
        <div class="md:w-1/2 bg-slate-100 flex items-center justify-center min-h-56">
          <img
            id="modal-img"
            src=""
            alt=""
            class="w-full h-full object-cover md:max-h-[88vh]"
          />
        </div>

        <!-- Info -->
        <div class="md:w-1/2 p-6 flex flex-col gap-4 bg-white">
          <div>
            <span id="modal-category" class="text-xs font-bold uppercase tracking-wider text-emerald-600"></span>
            <h4 id="modal-title" class="text-2xl font-black text-slate-900 mt-1"></h4>
            <span id="modal-density" class="inline-block mt-1 px-2.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold"></span>
          </div>

          <p id="modal-desc" class="text-sm text-slate-600 leading-relaxed"></p>

          <!-- Features -->
          <ul id="modal-features" class="space-y-1.5">
            <!-- se llena por JS -->
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.product-card');
  const modal = document.getElementById('product-modal');
  const closeBtn = document.getElementById('close-modal-btn');

  const modalImg    = document.getElementById('modal-img') as HTMLImageElement | null;
  const modalTitle    = document.getElementById('modal-title');
  const modalDesc     = document.getElementById('modal-desc');
  const modalDensity  = document.getElementById('modal-density');
  const modalCategory = document.getElementById('modal-category');
  const modalFeatures = document.getElementById('modal-features');

  const openModal = (card: Element) => {
    if (!modal || !modalImg || !modalTitle || !modalDesc || !modalDensity || !modalCategory || !modalFeatures) return;

    const src      = card.getAttribute('data-src') || '';
    const title    = card.getAttribute('data-title') || '';
    const desc     = card.getAttribute('data-desc') || '';
    const density  = card.getAttribute('data-density') || '';
    const category = card.getAttribute('data-category') || '';
    const features: string[] = JSON.parse(card.getAttribute('data-features') || '[]');

    modalImg.src      = src;
    modalImg.alt      = title;
    modalTitle.textContent    = title;
    modalDesc.textContent     = desc;
    modalDensity.textContent  = density;
    modalCategory.textContent = category;

    modalFeatures.innerHTML = features.map(f => `
      <li class="flex items-center gap-2 text-xs text-slate-700">
        <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span>${f}</span>
      </li>
    `).join('');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  cards.forEach(card => card.addEventListener('click', () => openModal(card)));
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
  });
</script>
