---
import { siteConfig } from '../data/siteData';
import { getTranslations } from '../data/translations';

interface Props {
  locale?: string;
}

const currentLocale = Astro.currentLocale || Astro.props.locale || 'es';
const t = getTranslations(currentLocale);
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Bloque Principal Centrado -->
    <div class="flex flex-col items-center justify-center text-center pb-12 border-b border-slate-800/80">
      
      <!-- Brand & Mission Column -->
      <div class="flex flex-col items-center space-y-4">
        <!-- Logo y Título -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full overflow-hidden border border-emerald-500 shadow-sm bg-white shrink-0">
            <img 
              src={siteConfig.logo} 
              alt="Logo Americana del Plástico" 
              class="w-full h-full object-cover"
              width="40"
              height="40"
              loading="lazy"
            />
          </div>
          <span class="text-xl font-black text-white tracking-tight">
            Americana del Plástico C.A.
          </span>
        </div>
        
        <!-- Descripción -->
        <p class="text-sm text-slate-400 leading-relaxed max-w-md mx-auto">
          {t.footer.desc}
        </p>

        <!-- Aliado OMKA -->
        <div class="pt-2 flex items-center justify-center gap-3">
          <img 
            src={siteConfig.omkaLogo} 
            alt="Grupo OMKA Empaques" 
            class="w-8 h-8 rounded-full border border-slate-700 object-cover shrink-0" 
            width="32" 
            height="32"
          />
          <span class="text-xs font-medium text-slate-500">
            {t.footer.omkaPartner}
          </span>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar (Centrado) -->
    <div class="pt-8 text-center text-xs text-slate-500 space-y-1">
      <p>
        &copy; {currentYear} {t.footer.rights}
      </p>
      <p class="text-[11px] text-slate-600">
        {t.footer.originFooter}
      </p>
    </div>

  </div>
</footer>
