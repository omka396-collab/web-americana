---
import { siteConfig } from '../data/siteData';
import { getTranslations } from '../data/translations';

interface Props {
  locale?: string;
}

const currentLocale = Astro.currentLocale || Astro.props.locale || 'es';
const t = getTranslations(currentLocale);
---

<section id="nosotros" class="py-20 lg:py-28 bg-slate-50 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
        {t.about.badge}
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        {t.about.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Main Story / Content Column -->
      <div class="lg:col-span-7 space-y-6 text-slate-700 leading-relaxed text-base sm:text-lg">
        
        <!-- Author Stamp Card -->
        <div class="flex items-center gap-4 p-5 rounded-2xl bg-white border border-slate-200 shadow-sm mb-6">
          <div class="relative w-16 h-16 rounded-full overflow-hidden border-2 border-emerald-600 flex-shrink-0">
            <img 
              src={siteConfig.logo} 
              alt={siteConfig.name} 
              class="w-full h-full object-cover"
              width="64"
              height="64"
            />
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900 leading-snug">
              {siteConfig.name}
            </h3>
            <p class="text-sm font-medium text-emerald-700">
              {t.about.authorRole}
            </p>
            <p class="text-xs text-slate-500 mt-0.5">
              {t.about.foundedLabel}
            </p>
          </div>
        </div>

        <p>
          {t.about.p1}
        </p>

        <p>
          {t.about.p2}
        </p>

      </div>

      <!-- Ubicación Column -->
      <div class="lg:col-span-5 space-y-3">

        <!-- Foto planta + Mapa en columna -->
        <div class="flex flex-col gap-3">
          <!-- Foto de la planta -->
          <div class="rounded-xl overflow-hidden border border-slate-200/80 shadow-sm h-52">
            <img
              src={siteConfig.factoryImage}
              alt="Planta Americana del Plástico en Ureña, Táchira"
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="208"
            />
          </div>

          <!-- Mapa embebido -->
          <div class="rounded-xl overflow-hidden border border-slate-200/80 shadow-sm h-52">
            <iframe
              src={siteConfig.mapUrl}
              class="w-full h-full"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de Americana del Plástico en Ureña, Táchira"
              aria-label="Mapa de ubicación de Americana del Plástico"
            ></iframe>
          </div>
        </div>

        <!-- Dirección + enlace -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <p class="text-xs text-slate-500 leading-relaxed">{t.about.address}</p>
          </div>
          <a
            href="https://maps.google.com/?q=Americana+del+Plastico,+Ureña,+Táchira,+Venezuela"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:text-emerald-600 transition-colors whitespace-nowrap flex-shrink-0"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            {t.about.viewMaps}
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
