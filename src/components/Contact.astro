---
import { siteConfig } from '../data/siteData';
---

<section id="contacto" class="py-20 lg:py-28 bg-slate-900 text-white relative overflow-hidden">
  <!-- Glowing background elements -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-3">
        Atención Comercial y Pedidos
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
        Conectá con Americana del Plástico
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        ¿Buscás calidad, puntualidad y precios directos de fábrica? Nuestro equipo de ingenieros y asesores comerciales está a tu disposición para cotizar tu pedido al mayor.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Contact Info & Channels Column -->
      <div class="lg:col-span-5 space-y-8">
        
        <div class="p-8 rounded-3xl bg-slate-800/80 border border-slate-700 backdrop-blur-md">
          <h3 class="text-xl font-black text-white mb-6">
            Canales de Atención Directa
          </h3>

          <ul class="space-y-6">
            <!-- Ubicación -->
            <li class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-400">Planta Principal</span>
                <p class="text-sm font-semibold text-slate-200 mt-0.5 leading-snug">
                  {siteConfig.address}
                </p>
              </div>
            </li>

            <!-- WhatsApp Directo -->
            <li class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-400">Atención Inmediata</span>
                <a 
                  href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors mt-0.5 inline-block"
                >
                  Contactar por WhatsApp Directo &rarr;
                </a>
              </div>
            </li>

            <!-- Redes Sociales -->
            <li class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-400">Redes y Difusión</span>
                <div class="flex items-center gap-4 mt-1">
                  <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-slate-300 hover:text-emerald-400 transition-colors">
                    Instagram
                  </a>
                  <span class="text-slate-600">•</span>
                  <a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-slate-300 hover:text-emerald-400 transition-colors">
                    Facebook
                  </a>
                </div>
              </div>
            </li>
          </ul>
        </div>

        <!-- Trust Note -->
        <div class="p-6 rounded-2xl bg-emerald-950/40 border border-emerald-500/20 text-slate-300 text-xs sm:text-sm leading-relaxed">
          <strong class="text-emerald-400 font-bold block mb-1">Garantía de Suministro Industrial:</strong>
          Capacidad de abastecimiento recurrente para cadenas de supermercados, panaderías, tiendas departamentales e industrias frigoríficas en toda Venezuela.
        </div>

      </div>

      <!-- Cotizador & Form Column -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-slate-800/90 border border-slate-700 shadow-2xl backdrop-blur-md">
          <h3 class="text-2xl font-black text-white mb-2">
            Solicitud de Presupuesto y Asesoría
          </h3>
          <p class="text-sm text-slate-300 mb-8">
            Completá tus datos y requerimientos. Te responderemos en breve con la cotización formal y tiempos de despacho.
          </p>

          <form id="contact-form" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Nombre <span class="text-emerald-400">*</span>
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Tu nombre" 
                  class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-sm"
                />
              </div>
              <div>
                <label for="last_name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Apellido <span class="text-emerald-400">*</span>
                </label>
                <input 
                  type="text" 
                  id="last_name" 
                  name="last_name" 
                  required 
                  placeholder="Tu apellido o empresa" 
                  class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Teléfono / WhatsApp <span class="text-emerald-400">*</span>
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  placeholder="(0414) 000-0000" 
                  class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-sm"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Correo Electrónico
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  placeholder="empresa@ejemplo.com" 
                  class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-sm"
                />
              </div>
            </div>

            <div>
              <label for="product_type" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Producto o Rubro de Interés
              </label>
              <select 
                id="product_type" 
                name="product_type" 
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-sm"
              >
                <option value="General">Consulta General / Varias Líneas</option>
                <option value="Bolsas Boutique">Bolsas Boutique (Comercio / Retail)</option>
                <option value="Bolsas tipo Cono">Bolsas tipo Cono (Snacks / Confitería)</option>
                <option value="Bolsas para Pan">Bolsas para Pan (Microperforadas)</option>
                <option value="Bolsas para Hielo">Bolsas para Hielo (Alta Resistencia Térmica)</option>
                <option value="Fabricacion Especial">Fabricación Especial sobre Medida</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Detalle del Pedido o Consulta <span class="text-emerald-400">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Indicanos cantidades estimadas, medidas o calibres requeridos..." 
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-sm resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-4 rounded-xl font-black text-sm uppercase tracking-wider text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-300 to-green-300 hover:from-emerald-300 hover:to-green-200 shadow-lg shadow-emerald-500/25 transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
              <span>Enviar Solicitud de Cotización</span>
            </button>

            <!-- Form Message Status Feedback -->
            <div id="form-feedback" class="hidden p-4 rounded-xl text-sm font-semibold text-center transition-all"></div>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const productSelect = document.getElementById('product_type') as HTMLSelectElement | null;

  // Pre-fill select if URL has hash with product param
  const syncProductFromHash = () => {
    const hash = window.location.hash;
    if (hash.includes('producto=') && productSelect) {
      const match = hash.match(/producto=([^&]+)/);
      if (match && match[1]) {
        const decoded = decodeURIComponent(match[1]);
        for (let i = 0; i < productSelect.options.length; i++) {
          if (productSelect.options[i].text.toLowerCase().includes(decoded.toLowerCase())) {
            productSelect.selectedIndex = i;
            break;
          }
        }
      }
    }
  };

  syncProductFromHash();
  window.addEventListener('hashchange', syncProductFromHash);

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const phone = formData.get('phone') as string;
      const product = formData.get('product_type') as string;
      const message = formData.get('message') as string;

      // Display immediate friendly confirmation
      feedback.classList.remove('hidden', 'bg-red-900/50', 'text-red-200', 'border-red-500');
      feedback.classList.add('bg-emerald-950/80', 'text-emerald-200', 'border', 'border-emerald-500');
      feedback.innerHTML = `
        <div class="space-y-2">
          <p class="font-bold">¡Gracias ${name}! Tu solicitud ha sido registrada exitosamente.</p>
          <p class="text-xs text-slate-300">Un asesor comercial de Americana del Plástico se comunicará contigo al ${phone}.</p>
          <div class="pt-2">
            <a 
              href="https://wa.me/584140000000?text=${encodeURIComponent(`Hola, soy ${name}. Dejé una solicitud por ${product}: ${message}`)}"
              target="_blank"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500 text-slate-950 font-bold text-xs hover:bg-emerald-400"
            >
              Abrir mensaje directo en WhatsApp
            </a>
          </div>
        </div>
      `;
      form.reset();
    });
  }
</script>
